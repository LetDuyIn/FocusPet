<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFF8F0">

    <TextView
        android:id="@+id/tv_title_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhiệm vụ hôm nay ✨"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3D3A50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_tasks_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoàn thành task để nhận xu và nuôi thú cưng mau lớn!"
        android:textSize="13sp"
        android:textColor="#8A87A0"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_tasks"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- RecyclerView danh sách công việc -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_tasks_summary"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Nút thêm công việc dạng FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm việc"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF9F6B"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>