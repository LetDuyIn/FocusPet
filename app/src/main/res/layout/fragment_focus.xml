<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/bg_cream">

    <com.midterm.petfocus.ui.art.ArtTextView
        android:id="@+id/tv_focus_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_focus_header"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.midterm.petfocus.ui.art.ArtTextView
        android:id="@+id/tv_focus_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_focus_desc"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_focus_header"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Khung tròn hiển thị đồng hồ đếm ngược -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_timer_circle"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:cardCornerRadius="130dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface_white"
        app:strokeColor="@color/peach"
        app:strokeWidth="6dp"
        app:layout_constraintTop_toBottomOf="@id/tv_focus_desc"
        app:layout_constraintBottom_toTopOf="@id/layout_presets"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_timer_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_timer_countdown"
                android:textSize="52sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_session_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_session_status"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nút chọn thời gian nhanh (15p, 25p, 45p, 60p) -->
    <LinearLayout
        android:id="@+id/layout_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btn_start_focus">

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_preset_15"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/btn_preset_15"
            app:cornerRadius="20dp" />

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_preset_25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/btn_preset_25"
            app:cornerRadius="20dp"
            android:backgroundTint="@color/peach" />

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_preset_45"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/btn_preset_45"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- Nút Bắt đầu đếm giờ -->
    <com.midterm.petfocus.ui.art.ArtButton
        android:id="@+id/btn_start_focus"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_start_focus"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        android:backgroundTint="@color/peach"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>