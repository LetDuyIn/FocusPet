<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/bg_cream">

    <!-- Header: Level Pet và Tiền Xu -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface_white"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_pet_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Level 2 • Mimi 🐱"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 120 Xu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_coin_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Khu vực hiển thị con Thú Cưng ở giữa (Lottie) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pet_stage"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface_white"
        app:layout_constraintTop_toBottomOf="@id/card_header_stats">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Lottie Animation của thú cưng -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_pet"
                android:layout_width="220dp"
                android:layout_height="220dp"
                app:lottie_fileName="pet_idle.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bong bóng lời thoại của Pet -->
            <TextView
                android:id="@+id/tv_pet_dialogue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meow! Sen làm bài tập LTDD chưa?"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_speech_bubble"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@id/lottie_pet"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Thanh tiến độ chỉ số: No bụng, Vui vẻ, Năng lượng -->
    <LinearLayout
        android:id="@+id/layout_pet_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/card_pet_stage">

        <!-- Chỉ số No bụng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="🍎 No bụng:"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_hunger"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="80"
                android:progressDrawable="@drawable/progress_peach" />
        </LinearLayout>

        <!-- Chỉ số Vui vẻ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="💖 Vui vẻ:"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_happiness"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="90"
                android:progressDrawable="@drawable/progress_mint" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4 Nút tương tác chính: Cho ăn, Nựng, Tắm, Ngủ -->
    <GridLayout
        android:id="@+id/grid_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_pet_stats">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_feed"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="Cho ăn"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp"
            android:backgroundTint="#FF9F6B" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cuddle"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="Nựng"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp"
            android:backgroundTint="#6BCB9F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clean"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="Tắm"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp"
            android:backgroundTint="#38BDF8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sleep"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="Ngủ"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp"
            android:backgroundTint="#818CF8" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>