<?xml version="1.0" encoding="utf-8"?>
<!-- Cuộn được để không mất hàng nút trên điện thoại màn hình nhỏ -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_cream">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/pet_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- Header: Level Pet và Tiền Xu -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface_white"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_pet_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tv_pet_level"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_coins"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_coin_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Khu vực hiển thị con Thú Cưng ở giữa (Lottie) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pet_stage"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface_white"
        app:layout_constraintTop_toBottomOf="@id/card_header_stats">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Lottie Animation của thú cưng -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_pet"
                android:layout_width="220dp"
                android:layout_height="220dp"
                app:lottie_fileName="pet_idle.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Phụ kiện theo giai đoạn trưởng thành (nơ / mũ tốt nghiệp / vương miện), đặt trên đầu mèo -->
            <ImageView
                android:id="@+id/iv_accessory"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/accessory_desc"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/lottie_pet"
                app:layout_constraintStart_toStartOf="@id/lottie_pet"
                app:layout_constraintEnd_toEndOf="@id/lottie_pet" />

            <!-- Giai đoạn trưởng thành hiện tại và cấp cần để lớn tiếp -->
            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_stage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bong bóng lời thoại của Pet -->
            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_pet_dialogue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_pet_dialogue"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_speech_bubble"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toTopOf="@id/lottie_pet"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Thanh tiến độ chỉ số: No bụng, Vui vẻ, Năng lượng -->
    <LinearLayout
        android:id="@+id/layout_pet_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/card_pet_stage">

        <!-- Chỉ số No bụng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <com.midterm.petfocus.ui.art.ArtTextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/fragment_pet_text"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_hunger"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="80"
                android:progressDrawable="@drawable/progress_peach" />
        </LinearLayout>

        <!-- Chỉ số Vui vẻ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <com.midterm.petfocus.ui.art.ArtTextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/fragment_pet_text_2"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_happiness"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="90"
                android:progressDrawable="@drawable/progress_mint" />
        </LinearLayout>

        <!-- Chỉ số Sức lực -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <com.midterm.petfocus.ui.art.ArtTextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/fragment_pet_text_3"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_energy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="80"
                android:progressDrawable="@drawable/progress_indigo" />
        </LinearLayout>

        <!-- Chỉ số Sạch sẽ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <com.midterm.petfocus.ui.art.ArtTextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/fragment_pet_text_4"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_clean"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="80"
                android:progressDrawable="@drawable/progress_sky" />
        </LinearLayout>

        <!-- Kinh nghiệm để lên cấp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <com.midterm.petfocus.ui.art.ArtTextView
                android:id="@+id/tv_exp"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/tv_exp"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />
            <ProgressBar
                android:id="@+id/progress_exp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="0"
                android:progressDrawable="@drawable/progress_gold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4 Nút tương tác chính: Cho ăn, Nựng, Tắm, Ngủ -->
    <GridLayout
        android:id="@+id/grid_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_pet_stats">

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_feed"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="@string/btn_feed"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:cornerRadius="25dp"
            android:backgroundTint="@color/peach" />

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_cuddle"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="@string/btn_cuddle"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:cornerRadius="25dp"
            android:backgroundTint="@color/mint" />

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_clean"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="@string/btn_clean"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:cornerRadius="25dp"
            android:backgroundTint="@color/sky" />

        <com.midterm.petfocus.ui.art.ArtButton
            android:id="@+id/btn_sleep"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            android:text="@string/btn_sleep"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:cornerRadius="25dp"
            android:backgroundTint="@color/indigo" />
    </GridLayout>

    <!-- Ghim widget ra màn hình chính (Android 8+ và launcher có hỗ trợ) -->
    <com.midterm.petfocus.ui.art.ArtButton
        android:id="@+id/btn_add_widget"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_add_widget"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/grid_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
